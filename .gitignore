node_modules/
*.tsbuildinfo

# 操作系统
.DS_Store

# IDE
.idea/

# 本地联调产物（构建 bundle、DOM dump、临时页面等），不进仓库
harness/

# 本地 AI 工具产物（记忆、技能等），不进仓库
.workbuddy/

